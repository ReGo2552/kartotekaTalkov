---
import type { CollectionEntry } from 'astro:content';
import SongRow from './SongRow.astro';

/**
 * «Две стороны одной медали»: монету переворачивают — и список песен
 * меняется с лирики на гражданскую линию и обратно.
 */
interface Props {
  lyric: CollectionEntry<'songs'>[];
  civic: CollectionEntry<'songs'>[];
}

const { lyric, civic } = Astro.props;
// На медали — первые песни ящика (они идут по шифрам), остальные в «Песнях».
const SHOWN = 12;
const more = (n: number) => n - SHOWN;
const rim = 'ИГОРЬ ТАЛЬКОВ · 1956 — 1991 · ИГОРЬ ТАЛЬКОВ · 1956 — 1991 ·';
// Окружность радиуса 78, начинается слева и идёт по часовой стрелке.
const rimPath = 'M100,100 m-78,0 a78,78 0 1,1 156,0 a78,78 0 1,1 -156,0';
---

<div class="medal" data-medal data-side="lyric">
  <div class="medal__coin-col">
    <button class="coin" type="button" data-coin aria-pressed="false" aria-label="Перевернуть медаль: показать гражданскую линию">
      <span class="coin__inner">
        <svg class="coin__face coin__face--lyric" viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="rim-lyric" d={rimPath} /></defs>
          <circle cx="100" cy="100" r="99" class="f-fill" />
          <circle cx="100" cy="100" r="92" class="f-ring" />
          <circle cx="100" cy="100" r="64" class="f-ring" />
          <text class="f-rim"><textPath href="#rim-lyric" textLength="488" lengthAdjust="spacing">{rim}</textPath></text>
          <text x="100" y="112" class="f-word">Лирика</text>
        </svg>
        <svg class="coin__face coin__face--civic" viewBox="0 0 200 200" aria-hidden="true">
          <defs><path id="rim-civic" d={rimPath} /></defs>
          <circle cx="100" cy="100" r="99" class="f-fill" />
          <circle cx="100" cy="100" r="92" class="f-ring" />
          <circle cx="100" cy="100" r="64" class="f-ring" />
          <text class="f-rim"><textPath href="#rim-civic" textLength="488" lengthAdjust="spacing">{rim}</textPath></text>
          <text x="100" y="100" class="f-word f-word--long">Гражданская</text>
          <text x="100" y="124" class="f-word f-word--sub">линия</text>
        </svg>
      </span>
    </button>
    <div class="switch" role="group" aria-label="Сторона медали">
      <button type="button" data-to="lyric" aria-pressed="true">Лирика</button>
      <button type="button" data-to="civic" aria-pressed="false">Гражданская</button>
    </div>
  </div>

  <div class="medal__panels" aria-live="polite">
    <div class="panel" data-panel="lyric">
      <h3 class="panel__title">Лирика</h3>
      <p class="panel__note">Песни о любви, памяти и тишине · {lyric.length}</p>
      <ul class="list">
        {lyric.slice(0, SHOWN).map((s) => <li><SongRow song={s} /></li>)}
      </ul>
      {more(lyric.length) > 0 && <a class="more" href="/pesni/">Все песни ящика →</a>}
    </div>
    <div class="panel" data-panel="civic" hidden>
      <h3 class="panel__title">Гражданская линия</h3>
      <p class="panel__note">Песни о России, истории и правде · {civic.length}</p>
      <ul class="list">
        {civic.slice(0, SHOWN).map((s) => <li><SongRow song={s} /></li>)}
      </ul>
      {more(civic.length) > 0 && <a class="more" href="/pesni/">Все песни ящика →</a>}
    </div>
  </div>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-medal]')) {
    const coin = root.querySelector<HTMLButtonElement>('[data-coin]')!;
    const tabs = root.querySelectorAll<HTMLButtonElement>('[data-to]');
    const panels = root.querySelectorAll<HTMLElement>('[data-panel]');

    const show = (side: string) => {
      root.dataset.side = side;
      const civic = side === 'civic';
      coin.setAttribute('aria-pressed', String(civic));
      coin.setAttribute('aria-label', `Перевернуть медаль: показать ${civic ? 'лирику' : 'гражданскую линию'}`);
      tabs.forEach((t) => t.setAttribute('aria-pressed', String(t.dataset.to === side)));
      panels.forEach((p) => (p.hidden = p.dataset.panel !== side));

      // Строки открывшегося списка заново появляются лесенкой.
      const rows = root.querySelectorAll<HTMLElement>(`[data-panel="${side}"] [data-reveal]`);
      rows.forEach((r, i) => {
        r.classList.remove('is-in');
        r.style.setProperty('--i', String(Math.min(i, 12)));
      });
      void root.offsetWidth;
      rows.forEach((r) => r.classList.add('is-in'));
    };

    // Монету подбрасывают: она взлетает и переворачивается в воздухе.
    coin.addEventListener('click', () => {
      coin.classList.remove('is-toss');
      void coin.offsetWidth;
      coin.classList.add('is-toss');
      show(root.dataset.side === 'civic' ? 'lyric' : 'civic');
    });
    tabs.forEach((t) => t.addEventListener('click', () => show(t.dataset.to!)));
  }
</script>

<style>
  .medal {
    --side: var(--text);
    display: grid;
    grid-template-columns: 280px 1fr;
    gap: 56px;
    align-items: start;
  }

  .medal[data-side='civic'] {
    --side: var(--red);
  }

  .medal__coin-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 20px;
    position: sticky;
    top: 24px;
  }

  /* ── Монета ── */
  .coin {
    width: 240px;
    aspect-ratio: 1;
    padding: 0;
    border: 0;
    border-radius: 50%;
    background: none;
    cursor: pointer;
    perspective: 900px;
  }

  .coin__inner {
    position: relative;
    display: block;
    width: 100%;
    height: 100%;
    transform-style: preserve-3d;
    transition: transform 0.7s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .medal[data-side='civic'] .coin__inner {
    transform: rotateY(180deg);
  }

  .coin:hover .coin__inner {
    scale: 1.03;
  }

  @media (prefers-reduced-motion: no-preference) {
    .coin.is-toss {
      animation: toss 0.7s cubic-bezier(0.3, 0.6, 0.4, 1);
    }
  }

  @keyframes toss {
    40% {
      translate: 0 -46px;
    }

    80% {
      translate: 0 3px;
    }
  }

  .coin__face {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    backface-visibility: hidden;
    filter: drop-shadow(0 18px 24px rgba(0, 0, 0, 0.6));
  }

  .coin__face--civic {
    transform: rotateY(180deg);
  }

  .f-ring {
    fill: none;
    stroke-width: 1;
  }

  .f-rim {
    font-family: var(--body);
    font-size: 10.5px;
    font-weight: 500;
  }

  .f-word {
    font-family: var(--display);
    font-weight: 800;
    font-size: 38px;
    text-transform: uppercase;
    text-anchor: middle;
  }

  .f-word--long {
    font-size: 27px;
  }

  .f-word--sub {
    font-weight: 600;
    font-size: 20px;
    letter-spacing: 0.08em;
  }

  /* светлая сторона — лирика */
  .coin__face--lyric .f-fill { fill: var(--text); }
  .coin__face--lyric .f-ring { stroke: #9a9a9a; }
  .coin__face--lyric .f-rim,
  .coin__face--lyric .f-word { fill: var(--bg); }

  /* красная сторона — гражданская линия */
  .coin__face--civic .f-fill { fill: var(--red); }
  .coin__face--civic .f-ring { stroke: rgba(10, 10, 10, 0.45); }
  .coin__face--civic .f-rim,
  .coin__face--civic .f-word { fill: var(--bg); }

  /* ── Подписи-переключатели ── */
  .switch {
    display: flex;
    gap: 4px;
  }

  .switch button {
    font: inherit;
    font-size: 0.85rem;
    color: var(--muted);
    background: none;
    border: 0;
    border-bottom: 2px solid transparent;
    padding: 4px 8px;
    cursor: pointer;
  }

  .switch button:hover {
    color: var(--text);
  }

  .switch button[aria-pressed='true'] {
    color: var(--text);
    border-bottom-color: var(--side);
  }

  /* ── Список ── */
  .panel:not([hidden]) {
    animation: panel-in 0.45s ease both;
  }

  @keyframes panel-in {
    from {
      opacity: 0;
      transform: translateY(8px);
    }
  }

  .panel__title {
    font-family: var(--display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.4rem, 5vw, 3.6rem);
    line-height: 0.9;
    color: var(--side);
  }

  .panel__note {
    color: var(--muted);
    margin: 10px 0 20px;
  }

  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    border-bottom: 1px solid var(--line);
  }

  .more {
    display: inline-block;
    margin-top: 16px;
    font-size: 0.9rem;
    color: var(--side);
    text-decoration: none;
  }

  .more:hover {
    text-decoration: underline;
  }

  @media (max-width: 820px) {
    .medal {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .medal__coin-col {
      position: static;
    }

    .coin {
      width: 190px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .coin__inner {
      transition: none;
    }

    .panel:not([hidden]) {
      animation: none;
    }
  }
</style>
