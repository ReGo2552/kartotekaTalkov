---
import type { CollectionEntry } from 'astro:content';
import CardRow from './CardRow.astro';
import { cardCode, cardHref } from '../lib/cards';

/** Строка песни в списке: шифр, название, год. */
interface Props {
  song: CollectionEntry<'songs'>;
  showLine?: boolean;
}

const { song, showLine = false } = Astro.props;
const d = song.data;
---

<CardRow href={cardHref('songs', song.id)} code={cardCode('songs', d.num)} title={d.title} aside={d.year}>
  {showLine && (
    <span slot="label" class:list={['line', { 'line--civic': d.line === 'гражданская' }]}>{d.line}</span>
  )}
</CardRow>

<style>
  .line {
    margin-left: 10px;
    font-size: 0.72rem;
    font-weight: 500;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--line-lyric);
    vertical-align: 2px;
  }

  .line--civic {
    color: var(--line-civic);
  }
</style>
