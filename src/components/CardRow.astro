---
import type { ImageMetadata } from 'astro';
import { Image } from 'astro:assets';

/** Строка в списке ящика: шифр, название, пометка справа. */
interface Props {
  href: string;
  code: string;
  title: string;
  /** Год или другая короткая пометка справа. */
  aside?: string;
  /** Пояснение под названием: роль, формат издания. */
  note?: string;
  /** Миниатюра: обложка, портрет. С `thumbs` без фото остаётся пустой квадрат. */
  thumb?: ImageMetadata;
  thumbs?: boolean;
}

const { href, code, title, aside, note, thumb, thumbs = false } = Astro.props;
---

<a class:list={['row', { 'row--thumb': thumbs }]} href={href} data-reveal>
  <span class="row__code" data-vt-code>{code}</span>
  {thumbs && (
    thumb
      ? <Image class="row__thumb" src={thumb} alt="" width={112} />
      : <span class="row__thumb row__thumb--empty" aria-hidden="true">{code.split('-')[0]}</span>
  )}
  <span class="row__main">
    <span class="row__title">{title}<slot name="label" /></span>
    {note && <span class="row__note">{note}</span>}
  </span>
  {aside && <span class="row__aside">{aside}</span>}
</a>

<style>
  .row {
    display: grid;
    grid-template-columns: 4.5rem 1fr auto;
    gap: 12px;
    align-items: baseline;
    padding: 14px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
  }

  .row--thumb {
    grid-template-columns: 4.5rem 56px 1fr auto;
    gap: 16px;
    align-items: center;
    padding: 10px 0;
  }

  .row:hover .row__title {
    color: var(--red);
  }

  .row__code {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--red);
    font-variant-numeric: tabular-nums;
  }

  /* :global — картинку рисует компонент Image, без метки стилей этого файла */
  .row :global(.row__thumb) {
    width: 56px;
    height: 56px;
    object-fit: cover;
    object-position: 50% 25%;
    background: #0f0f0f;
    filter: brightness(0.82);
    transition: filter 0.2s ease;
  }

  .row:hover :global(.row__thumb) {
    filter: none;
  }

  .row__thumb--empty {
    display: grid;
    place-items: center;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.6rem;
    color: #2c2c2c;
    box-shadow: inset 0 0 0 1px var(--line);
  }

  .row__main {
    display: flex;
    flex-direction: column;
  }

  .row__title {
    font-size: 1.2rem;
    font-weight: 500;
    line-height: 1.35;
  }

  .row__note {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .row__aside {
    font-size: 0.85rem;
    color: var(--muted);
    text-align: right;
  }

  @media (max-width: 560px) {
    .row {
      grid-template-columns: 3.8rem 1fr;
    }

    .row__aside {
      grid-column: 2;
      text-align: left;
      margin-top: -8px;
    }

    .row--thumb {
      grid-template-columns: 3.2rem 48px 1fr;
      gap: 12px;
    }

    .row--thumb :global(.row__thumb) {
      width: 48px;
      height: 48px;
    }

    .row--thumb .row__aside {
      grid-column: 3;
      margin-top: -10px;
    }
  }
</style>
