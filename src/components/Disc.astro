---
import { Picture } from 'astro:assets';
import type { PhotoData } from './Photo.astro';

/**
 * Обложка альбома как конверт, из которого достают пластинку или компакт-диск.
 * Что внутри, видно по формату издания: LP, миньон, гибкая пластинка или CD.
 * На наклейке — то, что печатают на настоящей: издатель, название, номер.
 */
interface Props {
  photo?: PhotoData;
  format: string;
  title: string;
  artist: string;
  label: string;
  catno?: string;
  year: string;
  /** Цвета наклейки на известных выпусках. */
  labels?: string[];
  code: string;
  class?: string;
}

const { photo, format, title, artist, label, catno, year, labels = [], code, class: cls } = Astro.props;

type Kind = 'lp' | 'single' | 'flexi' | 'cd';
const kind: Kind = /компакт/.test(format)
  ? 'cd'
  : /гибкая/.test(format)
    ? 'flexi'
    : /7″|миньон/.test(format)
      ? 'single'
      : 'lp';

const text =
  kind === 'cd'
    ? { out: 'Достать диск', in: 'Убрать в коробку' }
    : { out: 'Достать пластинку', in: 'Убрать в конверт' };

/** Наклейка: фон и цвет печати. Без сведений о цвете — бумажная. */
const COLORS: Record<string, [string, string]> = {
  красная: ['#b81d16', '#f3ede2'],
  белая: ['#ecebe6', '#151515'],
  чёрная: ['#121212', '#cfc7b4'],
};
const paint = (color?: string) => {
  const [bg, ink] = (color && COLORS[color]) || ['#d9d4c7', '#1b1b1b'];
  return `--label-bg: ${bg}; --label-ink: ${ink}`;
};

const widths = photo ? [...[240, 360, 480, 720].filter((w) => w < photo.src.width), photo.src.width] : [];
---

<figure class:list={['disc', `disc--${kind}`, cls]} style={paint(labels[0])} data-disc data-reveal="light" data-pagefind-ignore>
  <div class="disc__stage" data-disc-stage>
    <div class="disc__record" aria-hidden="true" data-print-hide>
      <div class="disc__spin">
        {kind === 'cd' ? (
          <span class="disc__ring">{catno ?? title}</span>
        ) : (
          <div class="disc__label">
            <span class="disc__publisher">{label}</span>
            <span class="disc__under">
              <span class="disc__title">{title}</span>
              <span class="disc__artist">{artist}</span>
              <span class="disc__catno">{[catno, year].filter(Boolean).join(' · ')}</span>
            </span>
          </div>
        )}
      </div>
    </div>

    <div class="disc__sleeve">
      {photo ? (
        <Picture src={photo.src} alt={photo.alt} widths={widths} sizes="(max-width: 900px) 70vw, 260px" formats={['avif', 'webp']} />
      ) : (
        <div class="disc__empty">
          <span class="disc__code">{code}</span>
          <span>Снимка обложки пока нет</span>
        </div>
      )}
    </div>
  </div>

  <div class="disc__controls" hidden data-print-hide data-disc-controls>
    <button class="disc__toggle" type="button" data-disc-toggle data-out={text.out} data-in={text.in}>{text.out}</button>
    {labels.length > 1 && (
      <span class="disc__colors" role="group" aria-label="Цвет наклейки">
        <span class="disc__colors-h">Наклейка:</span>
        {labels.map((c, i) => (
          <button type="button" style={paint(c)} aria-pressed={i === 0 ? 'true' : 'false'} data-disc-color>{c}</button>
        ))}
      </span>
    )}
  </div>

  {photo && (
    <figcaption>
      {photo.caption && <span class="disc__caption">{photo.caption}</span>}
      <span>{photo.url ? <a href={photo.url} target="_blank" rel="noopener">{photo.credit}</a> : photo.credit}</span>
    </figcaption>
  )}
</figure>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-disc]')) {
    const stage = root.querySelector<HTMLElement>('[data-disc-stage]')!;
    const toggle = root.querySelector<HTMLButtonElement>('[data-disc-toggle]')!;
    const colors = root.querySelectorAll<HTMLButtonElement>('[data-disc-color]');

    const set = (out: boolean) => {
      root.classList.toggle('is-out', out);
      toggle.textContent = out ? toggle.dataset.in! : toggle.dataset.out!;
    };
    const flip = () => set(!root.classList.contains('is-out'));

    stage.addEventListener('click', flip);
    toggle.addEventListener('click', flip);

    // Другая наклейка: пластинку достают, чтобы её было видно.
    colors.forEach((b) =>
      b.addEventListener('click', () => {
        root.style.setProperty('--label-bg', b.style.getPropertyValue('--label-bg'));
        root.style.setProperty('--label-ink', b.style.getPropertyValue('--label-ink'));
        colors.forEach((c) => c.setAttribute('aria-pressed', String(c === b)));
        set(true);
      }),
    );

    root.querySelector<HTMLElement>('[data-disc-controls]')!.hidden = false;
    root.classList.add('is-ready');
  }
</script>

<style>
  /*
   * Сцена шире конверта: справа место, куда выезжает пластинка.
   * Размеры — в долях ширины сцены (cqw), чтобы наклейка мельчала вместе с ней.
   * --s — сторона конверта, --sx — сдвиг конверта, --rx — насколько пластинка вышла из него.
   */
  .disc {
    margin: 0;
    container-type: inline-size;
  }

  .disc__stage {
    --s: 61.7cqw;
    --sx: calc(var(--s) * 0.26);
    --rx: calc(var(--s) * 0.1);
    position: relative;
    aspect-ratio: 1.62;
  }

  .disc.is-ready .disc__stage {
    cursor: pointer;
  }

  .disc.is-ready:not(.is-out) .disc__stage:hover {
    --rx: calc(var(--s) * 0.17);
  }

  .disc.is-out .disc__stage {
    --sx: 0px;
    --rx: calc(var(--s) * 0.64);
  }

  .disc__sleeve,
  .disc__record {
    position: absolute;
    top: 0;
    left: 0;
    transition: translate 0.7s cubic-bezier(0.3, 0.7, 0.2, 1);
  }

  .disc__sleeve {
    z-index: 1;
    width: var(--s);
    height: var(--s);
    translate: var(--sx) 0;
    overflow: hidden;
    background: #050505;
    box-shadow: 6px 0 18px rgb(0 0 0 / 0.55);
  }

  .disc__sleeve :global(img) {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .disc__empty {
    display: grid;
    place-content: center;
    gap: 4px;
    height: 100%;
    padding: 16px;
    text-align: center;
    font-size: 0.78rem;
    color: var(--muted);
    background: #0f0f0f;
  }

  .disc__code {
    color: var(--red);
    font-weight: 500;
  }

  /* Пластинка лежит за конвертом и выезжает вправо */
  .disc__record {
    --d: calc(var(--s) * 0.94);
    top: calc(var(--s) * 0.03);
    width: var(--d);
    height: var(--d);
    translate: calc(var(--sx) + var(--s) * 0.03 + var(--rx)) 0;
    border-radius: 50%;
    filter: drop-shadow(0 6px 14px rgb(0 0 0 / 0.6));
  }

  /* Блик стоит на месте, а бороздки под ним крутятся */
  .disc__record::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    background: conic-gradient(
      from 20deg,
      transparent 0 6%,
      rgb(255 255 255 / 0.09) 11%,
      transparent 17% 50%,
      rgb(255 255 255 / 0.07) 61%,
      transparent 67%
    );
    pointer-events: none;
  }

  .disc__spin {
    position: relative;
    width: 100%;
    height: 100%;
    border-radius: 50%;
    background: repeating-radial-gradient(circle, #0d0d0d 0 1.1px, #191919 1.5px 2.4px);
    box-shadow: inset 0 0 0 2px #050505;
  }

  /* 33⅓ оборота в минуту — 1,8 секунды на оборот */
  @media (prefers-reduced-motion: no-preference) {
    .disc__spin {
      animation: disc-spin 1.8s linear infinite paused;
    }

    .disc.is-out .disc__spin {
      animation-play-state: running;
    }

    .disc--cd .disc__spin {
      animation-duration: 1s;
    }
  }

  @keyframes disc-spin {
    to {
      rotate: 1turn;
    }
  }

  /* Как на настоящей наклейке: издатель над отверстием, название и номер под ним */
  .disc__label {
    --l: 0.35;
    position: absolute;
    inset: calc(50% - var(--l) * 50%);
    display: grid;
    grid-template-rows: 1fr 4cqw 1fr;
    justify-items: center;
    padding: 0 2.6cqw;
    overflow: hidden;
    border-radius: 50%;
    background: var(--label-bg);
    color: var(--label-ink);
    text-align: center;
    line-height: 1.05;
    box-shadow: 0 0 0 0.5cqw rgb(0 0 0 / 0.35);
  }

  /* Отверстие в центре */
  .disc__label::after {
    content: '';
    position: absolute;
    top: 50%;
    left: 50%;
    width: 2.4cqw;
    height: 2.4cqw;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--panel);
  }

  .disc__publisher {
    grid-row: 1;
    align-self: end;
    font-size: 1.5cqw;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .disc__under {
    grid-row: 3;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.3cqw;
    max-width: 100%;
  }

  .disc__title,
  .disc__artist {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    overflow: hidden;
    max-width: 100%;
    text-wrap: balance;
  }

  .disc__title {
    font-family: var(--display);
    font-weight: 800;
    font-size: 2.1cqw;
    text-transform: uppercase;
  }

  .disc__artist {
    font-size: 1.15cqw;
  }

  .disc__catno {
    margin-top: 0.6cqw;
    font-size: 1.05cqw;
    letter-spacing: 0.04em;
    white-space: nowrap;
    opacity: 0.8;
  }

  /* Миньон: наклейка крупнее, бороздок меньше */
  .disc--single .disc__label {
    --l: 0.46;
  }

  /* Гибкая пластинка: тонкая прозрачная плёнка, напечатано прямо на ней */
  .disc--flexi .disc__spin {
    background: repeating-radial-gradient(circle, rgb(170 180 190 / 0.32) 0 1px, rgb(120 130 140 / 0.2) 1.5px 2.6px);
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.25);
  }

  .disc--flexi .disc__label {
    --l: 0.42;
    background: rgb(255 255 255 / 0.12);
    color: var(--text-soft);
    box-shadow: none;
  }

  /* Компакт-диск: серебро, прозрачное кольцо у отверстия и радужный блик */
  .disc--cd .disc__spin {
    background: radial-gradient(
      circle closest-side,
      var(--panel) 0 12.5%,
      rgb(220 225 230 / 0.22) 13% 31%,
      #8f969b 31.5% 33%,
      rgb(200 205 210 / 0.45) 33.5% 38%,
      #c9ced2 38.5% 97%,
      #9ba1a6 97.5% 99.5%,
      transparent 100%
    );
    box-shadow: none;
  }

  .disc--cd .disc__record::after {
    background: conic-gradient(
        from 200deg,
        rgb(255 90 90 / 0.22),
        rgb(255 210 80 / 0.22),
        rgb(90 220 140 / 0.2),
        rgb(90 150 255 / 0.24),
        rgb(200 90 255 / 0.2),
        rgb(255 90 90 / 0.22)
      );
    mask: radial-gradient(circle closest-side, transparent 0 38%, #000 38.5% 97%, transparent 97.5%);
  }

  /* Номер у отверстия — по нему видно, что диск крутится */
  .disc__ring {
    position: absolute;
    top: 36%;
    left: 50%;
    translate: -50% 0;
    font-size: 1.15cqw;
    letter-spacing: 0.06em;
    white-space: nowrap;
    color: #4b5156;
  }

  .disc__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 18px;
    margin-top: 12px;
    font-size: 0.82rem;
  }

  .disc__controls[hidden] {
    display: none;
  }

  .disc__controls button {
    font: inherit;
    color: var(--text-soft);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-underline-offset: 4px;
  }

  .disc__controls button:hover {
    color: var(--text);
  }

  .disc__colors {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 4px 12px;
    color: var(--muted);
  }

  .disc__colors button {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    text-decoration: none;
  }

  /* Кружок-образец наклейки */
  .disc__colors button::before {
    content: '';
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background: var(--label-bg);
    box-shadow: 0 0 0 1px #555;
  }

  .disc__colors button[aria-pressed='true'] {
    color: var(--text);
  }

  .disc__colors button[aria-pressed='true']::before {
    box-shadow: 0 0 0 2px var(--text);
  }

  figcaption {
    display: grid;
    gap: 2px;
    margin-top: 8px;
    font-size: 0.78rem;
    line-height: 1.4;
    color: var(--muted);
  }

  .disc__caption {
    color: var(--text-soft);
  }

  figcaption a {
    text-decoration-color: #444;
  }

  figcaption a:hover {
    color: var(--text);
  }
</style>
