---
import '../styles/global.css';
import { allCardHrefs, pages } from '../lib/cards';

interface Props {
  title?: string;
  description?: string;
}

const { title, description = 'Фан-картотека о жизни и песнях Игоря Талькова (1956–1991): биография, песни, альбомы, люди, память.' } = Astro.props;
const fullTitle = title ? `${title} — Картотека Талькова` : 'Картотека Игоря Талькова';
const cards = await allCardHrefs();
const path = Astro.url.pathname;

const nav = [
  { href: '/biografiya/', label: 'Биография' },
  { href: '/pesni/', label: 'Песни' },
  { href: '/albomy/', label: 'Альбомы' },
  { href: '/kino/', label: 'Кино' },
  { href: '/lyudi/', label: 'Люди' },
  { href: '/pamyat/', label: 'Память' },
  { href: '/poisk/', label: 'Поиск' },
];

const footLinks = [pages.death, pages.author];
---

<!doctype html>
<html lang="ru">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="expect" href="#page-end" blocking="render" />
    <script is:inline>
      (function () {
        var root = document.documentElement;
        // Блоки прячутся до проявления, только если работает JS. Если скрипт
        // проявления так и не запустился, через 3 секунды всё показывается.
        root.classList.add('reveal-on');
        setTimeout(function () {
          if (!window.__reveal) root.classList.remove('reveal-on');
        }, 3000);

        // Переход между страницами: шифр строки перелетает в шифр карточки
        // и обратно. Имя перехода ставится только паре элементов.
        var NAME = 'card-code';
        var path = function (url) { return new URL(url, location.href).pathname; };
        var rowCode = function (p) { return document.querySelector('a[href="' + p + '"] [data-vt-code]'); };
        var cardCode = function () { return document.querySelector('[data-vt-code="card"]'); };
        // Страница из кэша истории может вернуться с именем на старой строке.
        var clear = function () {
          document.querySelectorAll('[data-vt-code]').forEach(function (el) { el.style.viewTransitionName = ''; });
        };

        addEventListener('pageswap', function (e) {
          clear();
          if (!e.viewTransition || !e.activation || !e.activation.entry) return;
          var el = rowCode(path(e.activation.entry.url)) || cardCode();
          if (el) el.style.viewTransitionName = NAME;
        });

        addEventListener('pagereveal', function (e) {
          clear();
          var from = window.navigation && navigation.activation && navigation.activation.from;
          if (!e.viewTransition || !from) return;
          var el = cardCode() || rowCode(path(from.url));
          if (!el) return;
          el.style.viewTransitionName = NAME;
          e.viewTransition.finished.finally(function () { el.style.viewTransitionName = ''; });
        });
      })();
    </script>
  </head>
  <body>
    <header class="top">
      <div class="wrap top__in">
        <a href="/" class="logo"><b aria-hidden="true"></b>Картотека Талькова</a>
        <nav class="top__nav" aria-label="Разделы">
          {nav.map((item) => (
            <a href={item.href} aria-current={path.startsWith(item.href) ? 'page' : undefined}>{item.label}</a>
          ))}
        </nav>
      </div>
    </header>

    <main>
      <slot />
    </main>
    <span id="page-end" hidden></span>

    <footer class="foot">
      <div class="wrap foot__in">
        <div class="foot__text">
          <p>
            Любительская картотека, собранная поклонником. Не является официальным сайтом.
            Права на песни, записи и фотографии принадлежат их правообладателям.
          </p>
          <p>
            Сведения собраны по открытым источникам и могут быть неточными: в книгах,
            на конвертах и в справочниках расходятся даты, издания и даже названия песен.
            В картотеку внесены не все песни. Карточки со штампом «требует сверки»
            опираются на один источник, со штампом «заполняется» — ещё не дописаны.
          </p>
        </div>
        <div class="foot__links">
          {footLinks.map((l) => <a href={l.path}>{l.title}</a>)}
          <button class="foot__random" type="button" data-random>Случайная карточка</button>
        </div>
      </div>
    </footer>

    <script is:inline type="application/json" id="card-index" set:html={JSON.stringify(cards)} />
    <script>
      // Проявление блоков при прокрутке. Блоки, дошедшие до экрана вместе,
      // появляются лесенкой.
      const show = (els: HTMLElement[]) =>
        els.forEach((el, i) => {
          el.style.setProperty('--i', String(Math.min(i, 12)));
          el.classList.add('is-in');
        });
      const io = new IntersectionObserver(
        (entries) => {
          const seen = entries.filter((e) => e.isIntersecting).map((e) => e.target as HTMLElement);
          seen.forEach((el) => io.unobserve(el));
          show(seen);
        },
        { rootMargin: '0px 0px -6% 0px' },
      );
      // То, что видно сразу, проявляется без ожидания наблюдателя.
      const items = [...document.querySelectorAll<HTMLElement>('[data-reveal]')];
      const inView = (el: HTMLElement) => {
        const r = el.getBoundingClientRect();
        return r.bottom > 0 && r.top < innerHeight && r.width > 0;
      };
      show(items.filter(inView));
      items.filter((el) => !el.classList.contains('is-in')).forEach((el) => io.observe(el));
      (window as Window & { __reveal?: boolean }).__reveal = true;

      const hrefs: string[] = JSON.parse(document.getElementById('card-index')?.textContent ?? '[]');
      for (const btn of document.querySelectorAll<HTMLElement>('[data-random]')) {
        btn.addEventListener('click', () => {
          const others = hrefs.filter((h) => h !== location.pathname);
          const pool = others.length ? others : hrefs;
          if (pool.length) location.href = pool[Math.floor(Math.random() * pool.length)];
        });
      }
    </script>
  </body>
</html>

<style>
  .top {
    border-bottom: 1px solid var(--line);
    view-transition-name: top;
  }

  .top__in {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 0.6rem 1.5rem;
    min-height: 72px;
    flex-wrap: wrap;
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 10px;
    font-weight: 600;
    text-decoration: none;
    letter-spacing: 0.02em;
  }

  .logo b {
    width: 22px;
    height: 6px;
    background: var(--red);
  }

  .top__nav {
    display: flex;
    gap: 1.4rem;
    font-size: 0.92rem;
    color: var(--muted);
  }

  .top__nav a {
    text-decoration: none;
    padding-block: 4px;
    border-bottom: 2px solid transparent;
  }

  .top__nav a:hover {
    color: var(--text);
  }

  .top__nav a[aria-current='page'] {
    color: var(--text);
    border-bottom-color: var(--red);
  }

  .foot {
    margin-top: 120px;
    border-top: 1px solid var(--line);
    padding-block: 32px 48px;
    color: var(--muted);
    font-size: 0.88rem;
  }

  .foot__in {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    gap: 24px;
  }

  .foot p {
    margin: 0 0 12px;
    max-width: 62ch;
  }

  .foot p:last-child {
    margin-bottom: 0;
  }

  .foot__links {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 6px;
    flex-shrink: 0;
  }

  .foot__links a {
    text-decoration: none;
  }

  .foot__links a:hover {
    color: var(--text);
  }

  .foot__random {
    font: inherit;
    color: var(--text);
    background: none;
    border: 0;
    padding: 0;
    cursor: pointer;
    text-decoration: underline;
    text-decoration-color: var(--red);
    text-underline-offset: 4px;
    flex-shrink: 0;
  }

  .foot__random:hover {
    color: var(--red);
  }

  @media (max-width: 820px) {
    .top__in {
      padding-block: 14px;
    }

    .top__nav {
      width: 100%;
      overflow-x: auto;
      gap: 1.1rem;
      scrollbar-width: none;
    }

    .foot__in {
      flex-direction: column;
    }
  }
</style>
