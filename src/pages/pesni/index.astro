---
import Base from '../../layouts/Base.astro';
import DrawerHead from '../../components/DrawerHead.astro';
import Note from '../../components/Note.astro';
import SongRow from '../../components/SongRow.astro';
import { drawers, getSongs } from '../../lib/cards';

const songs = (await getSongs()).sort((a, b) => a.data.title.localeCompare(b.data.title, 'ru'));
const lyric = songs.filter((s) => s.data.line === 'лирика').length;
const civic = songs.length - lyric;

function songsWord(n: number) {
  const m10 = n % 10;
  const m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return 'песня';
  if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return 'песни';
  return 'песен';
}

// Песни по первой букве названия, как в ящике картотеки.
const letter = (title: string) => title.replace(/^[^\p{L}\d]+/u, '')[0].toUpperCase().replace('Ё', 'Е');
const groups = Object.entries(Object.groupBy(songs, (s) => letter(s.data.title)));

const filters = [
  { key: 'all', label: 'Все', count: songs.length },
  { key: 'лирика', label: 'Лирика', count: lyric },
  { key: 'гражданская', label: 'Гражданская', count: civic },
];
---

<Base title="Песни" description="Ящик «Песни»: карточки песен Игоря Талькова по алфавиту — год, авторы, первое издание.">
  <div class="wrap">
    <DrawerHead letter={drawers.songs.letter} title="Песни">
      <p>
        Карточки разложены по алфавиту. У каждой песни указана линия:
        лирика или <span class="civic">гражданская</span>.
      </p>
    </DrawerHead>

    <Note>
      <p>
        Здесь {songs.length} {songsWord(songs.length)}, и это не полный список. Многие песни Тальков пел только
        на концертах, часть дошла до нас лишь в любительских записях. Годы и первые издания
        в разных источниках не совпадают, а линия песни — оценка составителя. Если
        в карточке нет года, он не установлен.
      </p>
    </Note>

    <div class="tools" data-pagefind-ignore>
      <div class="filter" role="group" aria-label="Показать песни" data-filter-buttons hidden>
        {filters.map((f, i) => (
          <button type="button" data-filter={f.key} aria-pressed={i === 0 ? 'true' : 'false'}>
            {f.label} <span>{f.count}</span>
          </button>
        ))}
      </div>
      <nav class="letters" aria-label="Буквы">
        {groups.map(([l], i) => <a href={`#bukva-${i}`} data-letter-link={i}>{l}</a>)}
      </nav>
    </div>

    <div data-songs>
      {groups.map(([l, list], i) => (
        <section class="group" id={`bukva-${i}`} aria-label={`На букву ${l}`} data-group>
          <h2 class="group__letter">{l}</h2>
          <ul class="card-list">
            {list!.map((s) => <li data-line={s.data.line}><SongRow song={s} showLine /></li>)}
          </ul>
        </section>
      ))}
    </div>
  </div>
</Base>

<script>
  // Фильтр по линии. Без скрипта видны все песни, а кнопки спрятаны.
  const bar = document.querySelector<HTMLElement>('[data-filter-buttons]');
  const buttons = document.querySelectorAll<HTMLButtonElement>('[data-filter]');
  const groups = document.querySelectorAll<HTMLElement>('[data-group]');

  const apply = (key: string) => {
    buttons.forEach((b) => b.setAttribute('aria-pressed', String(b.dataset.filter === key)));
    groups.forEach((g, i) => {
      let shown = 0;
      g.querySelectorAll<HTMLElement>('li[data-line]').forEach((li) => {
        li.hidden = key !== 'all' && li.dataset.line !== key;
        if (!li.hidden) shown++;
      });
      g.hidden = shown === 0;
      const link = document.querySelector<HTMLElement>(`[data-letter-link="${i}"]`);
      if (link) link.hidden = shown === 0;
    });
  };

  if (bar) {
    bar.hidden = false;
    buttons.forEach((b) => b.addEventListener('click', () => apply(b.dataset.filter!)));
  }
</script>

<style>
  .civic {
    color: var(--red);
  }

  .tools {
    position: sticky;
    top: 0;
    z-index: 2;
    display: grid;
    gap: 10px;
    max-width: 880px;
    padding: 12px 0;
    margin-bottom: 12px;
    background: var(--bg);
    border-bottom: 1px solid var(--line);
  }

  .filter {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .filter[hidden] {
    display: none;
  }

  .filter button {
    font: inherit;
    font-size: 0.85rem;
    color: var(--muted);
    background: none;
    border: 0;
    box-shadow: inset 0 0 0 1px #3a3a3a;
    padding: 6px 12px;
    cursor: pointer;
  }

  .filter button span {
    margin-left: 4px;
    font-size: 0.75rem;
    color: #6d6d6d;
  }

  .filter button:hover {
    color: var(--text);
  }

  .filter button[aria-pressed='true'] {
    color: var(--text);
    box-shadow: inset 0 0 0 1px var(--text);
  }

  .filter button[data-filter='гражданская'][aria-pressed='true'] {
    color: var(--red);
    box-shadow: inset 0 0 0 1px var(--red);
  }

  .letters {
    display: flex;
    flex-wrap: wrap;
    gap: 2px 4px;
  }

  .letters a {
    min-width: 1.6em;
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.35rem;
    line-height: 1.2;
    text-align: center;
    text-decoration: none;
    color: var(--muted);
  }

  .letters a:hover {
    color: var(--red);
  }

  .letters a[hidden] {
    display: none;
  }

  .group {
    max-width: 880px;
    scroll-margin-top: 120px;
  }

  .group + .group {
    margin-top: 28px;
  }

  .group__letter {
    font-family: var(--display);
    font-weight: 800;
    font-size: 2.6rem;
    line-height: 1;
    color: var(--red);
    margin-bottom: 4px;
  }
</style>
