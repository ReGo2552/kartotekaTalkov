---
import CardPage from '../../components/CardPage.astro';
import CardText from '../../components/CardText.astro';
import Tag from '../../components/Tag.astro';
import { albumsWithSong, cardCode, drawers, getSongs, resolveRef } from '../../lib/cards';

export async function getStaticPaths() {
  const songs = await getSongs();
  return songs.map((song) => ({ params: { id: song.id }, props: { song } }));
}

const { song } = Astro.props;
const d = song.data;

// К ручным ссылкам добавляются альбомы картотеки, где есть эта песня.
const refs = [...new Set([...d.see, ...(await albumsWithSong(d.title))])];
const see = await Promise.all(refs.map(resolveRef));

const authors =
  d.music === d.words
    ? [{ label: 'Музыка и слова', value: d.music }]
    : [
        { label: 'Музыка', value: d.music },
        { label: 'Слова', value: d.words },
      ];

const fields = [
  { label: 'Год', value: d.year },
  ...authors,
  { label: 'Первое издание', value: d.album },
  { label: 'Известность', value: d.known },
];

const query = encodeURIComponent(`Игорь Тальков ${d.title}`);
const listen = [
  { label: 'YouTube', href: `https://www.youtube.com/results?search_query=${query}` },
  { label: 'Яндекс Музыка', href: `https://music.yandex.ru/search?text=${query}` },
  { label: 'ВКонтакте', href: `https://vk.com/audio?q=${query}` },
];
---

<CardPage
  title={d.title}
  description={`Карточка песни Игоря Талькова «${d.title}»: год, авторы, история.`}
  code={cardCode('songs', d.num)}
  drawer="Ящик «Песни»"
  crumb={{ href: `${drawers.songs.path}/`, label: 'Песни' }}
  fields={fields}
  see={see}
  sources={d.sources}
>
  <Fragment slot="tags">
    <Tag tone={d.line === 'гражданская' ? 'red' : 'muted'}>{d.line}</Tag>
    <Tag>{d.status}</Tag>
  </Fragment>

  {d.quote ? (
    <blockquote class="quote">{d.quote}</blockquote>
  ) : (
    import.meta.env.DEV && <p class="quote quote--empty">Строка из песни ещё не вписана: поле quote в файле карточки</p>
  )}

  <CardText entry={song} />

  <section class="block" aria-labelledby="listen-h" data-pagefind-ignore>
    <h2 id="listen-h" class="block__h">Слушать</h2>
    <ul class="chips">
      {listen.map((l) => (
        <li><a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>
      ))}
    </ul>
  </section>
</CardPage>

<style>
  .quote {
    margin: 0 0 32px;
    padding-left: 20px;
    border-left: 3px solid var(--red);
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.9rem;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .quote--empty {
    font-family: var(--body);
    font-weight: 400;
    font-size: 0.85rem;
    text-transform: none;
    color: var(--muted);
    border-left-style: dashed;
    border-left-color: var(--muted);
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips a {
    display: inline-block;
    font-size: 0.9rem;
    text-decoration: none;
    padding: 8px 14px;
    box-shadow: inset 0 0 0 1px #444;
  }

  .chips a:hover {
    box-shadow: inset 0 0 0 1px var(--red);
    color: var(--red);
  }
</style>
