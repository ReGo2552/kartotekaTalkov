---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import IndexCard from '../../components/IndexCard.astro';
import Tag from '../../components/Tag.astro';
import { cardCode, getSongs, resolveRef } from '../../lib/cards';

export async function getStaticPaths() {
  const songs = await getSongs();
  return songs.map((song) => ({ params: { id: song.id }, props: { song } }));
}

const { song } = Astro.props;
const d = song.data;
const { Content } = await render(song);
const hasBody = song.body?.trim();
const see = await Promise.all(d.see.map(resolveRef));

const authors =
  d.music === d.words
    ? [{ label: 'Музыка и слова', value: d.music }]
    : [
        { label: 'Музыка', value: d.music },
        { label: 'Слова', value: d.words },
      ];

const fields = [
  { label: 'Год', value: d.year },
  ...authors,
  { label: 'Альбом', value: d.album },
  { label: 'Известность', value: d.known },
].filter((f) => f.value);

const query = encodeURIComponent(`Игорь Тальков ${d.title}`);
const listen = [
  { label: 'YouTube', href: `https://www.youtube.com/results?search_query=${query}` },
  { label: 'Яндекс Музыка', href: `https://music.yandex.ru/search?text=${query}` },
  { label: 'ВКонтакте', href: `https://vk.com/audio?q=${query}` },
];
---

<Base title={d.title} description={`Карточка песни Игоря Талькова «${d.title}»: год, авторы, история.`}>
  <div class="wrap page">
    <nav class="crumbs" aria-label="Путь">
      <a href="/">Картотека</a> / <a href="/pesni/">Песни</a>
    </nav>

    <IndexCard code={cardCode('songs', d.num)} drawer="Ящик «Песни»" title={d.title}>
      <Fragment slot="tags">
        <Tag tone={d.line === 'гражданская' ? 'red' : 'muted'}>{d.line}</Tag>
        <Tag>{d.status}</Tag>
      </Fragment>

      <dl class="fields">
        {fields.map((f) => (
          <div>
            <dt>{f.label}</dt>
            <dd>{f.value}</dd>
          </div>
        ))}
      </dl>

      {d.quote ? (
        <blockquote class="quote">{d.quote}</blockquote>
      ) : (
        import.meta.env.DEV && <p class="quote quote--empty">Строка из песни ещё не вписана: поле quote в файле карточки</p>
      )}

      <div class="prose">
        {hasBody ? <Content /> : <p class="pending">Карточка заполняется. Текст появится после сверки источников.</p>}
      </div>

      <section class="block" aria-labelledby="listen-h">
        <h2 id="listen-h" class="block__h">Слушать</h2>
        <ul class="chips">
          {listen.map((l) => (
            <li><a href={l.href} target="_blank" rel="noopener">{l.label} ↗</a></li>
          ))}
        </ul>
      </section>

      {see.length > 0 && (
        <section class="block" aria-labelledby="see-h">
          <h2 id="see-h" class="block__h">См. также</h2>
          <ul class="refs">
            {see.map((r) => (
              <li><a href={r.href}><span class="refs__code">{r.code}</span>{r.title}</a></li>
            ))}
          </ul>
        </section>
      )}

      {d.sources.length > 0 && (
        <section class="block" aria-labelledby="src-h">
          <h2 id="src-h" class="block__h">Источники</h2>
          <ol class="sources">
            {d.sources.map((s) => (
              <li>{s.url ? <a href={s.url} target="_blank" rel="noopener">{s.title}</a> : s.title}</li>
            ))}
          </ol>
        </section>
      )}
    </IndexCard>
  </div>
</Base>

<style>
  .page {
    max-width: 960px;
    padding-top: 32px;
  }

  .crumbs {
    font-size: 0.85rem;
    color: var(--muted);
    margin-bottom: 16px;
  }

  .crumbs a {
    text-decoration: none;
  }

  .crumbs a:hover {
    color: var(--text);
  }

  .fields {
    margin: 0 0 32px;
  }

  .fields div {
    display: grid;
    grid-template-columns: 11rem 1fr;
    gap: 12px;
    padding: 10px 0;
    border-top: 1px solid var(--line);
  }

  .fields div:last-child {
    border-bottom: 1px solid var(--line);
  }

  .fields dt {
    color: var(--muted);
    font-size: 0.85rem;
    padding-top: 2px;
  }

  .fields dd {
    margin: 0;
  }

  .quote {
    margin: 0 0 32px;
    padding-left: 20px;
    border-left: 3px solid var(--red);
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.9rem;
    line-height: 1.1;
    text-transform: uppercase;
  }

  .quote--empty {
    font-family: var(--body);
    font-weight: 400;
    font-size: 0.85rem;
    text-transform: none;
    color: var(--muted);
    border-left-style: dashed;
    border-left-color: var(--muted);
  }

  .prose {
    max-width: 64ch;
    color: #d6d6d6;
  }

  .prose :global(h2) {
    font-family: var(--display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 1.5rem;
    color: var(--text);
    margin: 32px 0 6px;
  }

  .prose :global(h2:first-child) {
    margin-top: 0;
  }

  .prose :global(p) {
    margin: 0 0 14px;
  }

  .prose :global(strong) {
    color: #fff;
  }

  .pending {
    color: var(--muted);
    font-style: italic;
  }

  .block {
    margin-top: 36px;
  }

  .block__h {
    font-family: var(--display);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    font-size: 1.25rem;
    color: var(--muted);
    margin-bottom: 10px;
  }

  .chips,
  .refs,
  .sources {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }

  .chips a {
    display: inline-block;
    font-size: 0.9rem;
    text-decoration: none;
    padding: 8px 14px;
    box-shadow: inset 0 0 0 1px #444;
  }

  .chips a:hover {
    box-shadow: inset 0 0 0 1px var(--red);
    color: var(--red);
  }

  .refs a {
    display: flex;
    gap: 12px;
    align-items: baseline;
    padding: 8px 0;
    border-top: 1px solid var(--line);
    text-decoration: none;
    font-weight: 500;
  }

  .refs a:hover {
    color: var(--red);
  }

  .refs__code {
    width: 4.5rem;
    flex-shrink: 0;
    font-size: 0.8rem;
    color: var(--red);
    font-variant-numeric: tabular-nums;
  }

  .sources {
    counter-reset: src;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .sources li {
    counter-increment: src;
    position: relative;
    padding: 3px 0 3px 2rem;
  }

  .sources li::before {
    content: counter(src) '.';
    position: absolute;
    left: 0;
  }

  .sources a {
    color: var(--text-soft);
    word-break: break-word;
  }

  @media (max-width: 560px) {
    .fields div {
      grid-template-columns: 1fr;
      gap: 0;
    }
  }
</style>
