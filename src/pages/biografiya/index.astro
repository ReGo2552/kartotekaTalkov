---
import Base from '../../layouts/Base.astro';
import CardText from '../../components/CardText.astro';
import DrawerHead from '../../components/DrawerHead.astro';
import Photo from '../../components/Photo.astro';
import Tag from '../../components/Tag.astro';
import { cardCode, drawers, getCards, pages } from '../../lib/cards';

const periods = await getCards('bio');
---

<Base title="Биография" description="Биография Игоря Талькова по периодам: Щёкино, поиски, «Электроклуб», «Спасательный круг», «Суд».">
  <div class="wrap">
    <DrawerHead letter={drawers.bio.letter} title="Биография">
      <p>
        Жизнь Игоря Талькова по периодам: от детства в Щёкине до 1991 года.
        Каждый период — отдельная карточка со своими источниками.
      </p>
    </DrawerHead>

    <nav class="toc" aria-label="Периоды">
      {periods.map((p) => (
        <a href={`#${p.id}`}>
          <span class="toc__code">{cardCode('bio', p.data.num)}</span>
          <span class="toc__years">{p.data.years}</span>
          <span class="toc__title">{p.data.title}</span>
        </a>
      ))}
    </nav>

    <div data-pagefind-body>
      {periods.map((p) => (
        <section class="period" aria-labelledby={p.id} data-reveal>
          <div class="period__side">
            <span class="period__code" data-pagefind-ignore>{cardCode('bio', p.data.num)}</span>
            <span class="period__years">{p.data.years}</span>
            <span data-pagefind-ignore><Tag>{p.data.status}</Tag></span>
            <Photo
              photo={p.data.photo}
              shape="square"
              code={cardCode('bio', p.data.num)}
              sizes="(max-width: 820px) 280px, 200px"
              class="period__photo"
            />
          </div>
          <div class="period__body">
            <h2 id={p.id} class="period__title">{p.data.title}</h2>
            <CardText entry={p} />
            {p.data.sources.length > 0 && (
              <details class="period__src" data-pagefind-ignore>
                <summary>Источники · {p.data.sources.length}</summary>
                <ol>
                  {p.data.sources.map((s) => (
                    <li>{s.url ? <a href={s.url} target="_blank" rel="noopener">{s.title}</a> : s.title}</li>
                  ))}
                </ol>
              </details>
            )}
          </div>
        </section>
      ))}

      <section class="period period--end" aria-label="6 октября 1991">
        <div class="period__side">
          <span class="period__code">{pages.death.code}</span>
          <span class="period__years">1991</span>
        </div>
        <div class="period__body">
          <p class="end">
            6 октября 1991 года Игорь Тальков погиб в Санкт-Петербурге.
            Ему было 34 года. <a href={pages.death.path}>Карточка «6 октября 1991» →</a>
          </p>
        </div>
      </section>
    </div>
  </div>
</Base>

<style>
  .toc {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 1px;
    background: var(--line);
    border: 1px solid var(--line);
    margin-bottom: 64px;
  }

  .toc a {
    display: grid;
    gap: 2px;
    padding: 14px 16px;
    background: var(--bg);
    text-decoration: none;
  }

  .toc a:hover {
    background: var(--panel);
  }

  .toc__code {
    font-size: 0.75rem;
    color: var(--red);
    font-weight: 500;
  }

  .toc__years {
    font-size: 0.85rem;
    color: var(--muted);
  }

  .toc__title {
    font-family: var(--display);
    font-weight: 800;
    font-size: 1.5rem;
    text-transform: uppercase;
    line-height: 1;
  }

  .period {
    display: grid;
    grid-template-columns: 200px 1fr;
    gap: 40px;
    padding: 40px 0;
    border-top: 1px solid var(--line);
  }

  .period__side {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 8px;
  }

  .period__side :global(.period__photo) {
    width: 100%;
    margin-top: 16px;
  }

  .period__code {
    font-size: 0.8rem;
    font-weight: 500;
    color: var(--red);
  }

  .period__years {
    font-family: var(--display);
    font-weight: 800;
    font-size: 2.6rem;
    line-height: 0.9;
  }

  .period__title {
    font-family: var(--display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.2rem, 5vw, 3.2rem);
    line-height: 0.95;
    margin-bottom: 20px;
    scroll-margin-top: 24px;
  }

  .period__src {
    margin-top: 20px;
    font-size: 0.88rem;
    color: var(--muted);
  }

  .period__src summary {
    cursor: pointer;
    width: fit-content;
  }

  .period__src summary:hover {
    color: var(--text);
  }

  .period__src ol {
    margin: 10px 0 0;
    padding-left: 1.6rem;
  }

  .period__src a {
    color: var(--text-soft);
    word-break: break-word;
  }

  .period--end .period__years {
    color: var(--red);
  }

  .end {
    margin: 0;
    max-width: 64ch;
    font-size: 1.15rem;
  }

  .end a {
    color: var(--red);
    text-decoration: none;
    white-space: nowrap;
  }

  .end a:hover {
    color: var(--red-hover);
  }

  @media (max-width: 820px) {
    .period {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .period__side {
      flex-direction: row;
      flex-wrap: wrap;
      align-items: baseline;
      gap: 14px;
    }

    .period__side :global(.period__photo) {
      order: 5;
      max-width: 280px;
      margin-top: 4px;
    }

    .period__years {
      font-size: 1.8rem;
    }
  }
</style>
