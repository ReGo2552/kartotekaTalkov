---
import { Image, Picture } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Drawer from '../components/Drawer.astro';
import Medal from '../components/Medal.astro';
import { drawers as box, getCards, pages, resolveRef } from '../lib/cards';
import hero from '../photos/talkov-1991.png';
import autograph from '../photos/avtograf.png';

const [songs, albums, films, people] = await Promise.all([
  getCards('songs'),
  getCards('albums'),
  getCards('films'),
  getCards('people'),
]);
const lyric = songs.filter((s) => s.data.line === 'лирика');
const civic = songs.filter((s) => s.data.line === 'гражданская');

function cardsWord(n: number) {
  const m10 = n % 10;
  const m100 = n % 100;
  if (m10 === 1 && m100 !== 11) return 'карточка';
  if (m10 >= 2 && m10 <= 4 && (m100 < 12 || m100 > 14)) return 'карточки';
  return 'карточек';
}

const count = (n: number) => `${n} ${cardsWord(n)}`;
const drawer = (key: keyof typeof box, note: string) => ({
  letter: box[key].letter,
  title: box[key].name,
  href: `${box[key].path}/`,
  note,
});
const single = (page: (typeof pages)[keyof typeof pages], note: string) => ({
  letter: page.code[0],
  title: page.title,
  href: page.path,
  note,
});

const drawers = [
  drawer('bio', '1956–1991'),
  drawer('songs', count(songs.length)),
  drawer('albums', count(albums.length)),
  drawer('films', count(films.length)),
  drawer('people', count(people.length)),
  single(pages.death, 'следствие и приговор'),
  single(pages.memory, 'музей, памятники, книги'),
  single(pages.author, 'зачем эта картотека'),
];

// Последняя строка главной — из песни «Я вернусь».
const coda = await resolveRef('songs/ya-vernus');
---

<Base>
  <section class="hero">
    <div class="hero__photo">
      <Picture
        src={hero}
        alt="Игорь Тальков на сцене, январь 1991 года: чёрный пиджак, красная повязка на голове"
        widths={[480, 720, hero.width]}
        sizes="(max-width: 820px) 100vw, 50vw"
        formats={['avif', 'webp']}
        fallbackFormat="jpg"
        loading="eager"
        fetchpriority="high"
      />
      <Image class="hero__sig" src={autograph} alt="Автограф Игоря Талькова" width={480} />
    </div>
    <div class="hero__text">
      <h1><span>Игорь</span> <span>Тальков</span></h1>
      <p class="dates"><span>1956</span><i aria-hidden="true"></i><span>1991</span></p>
      <p class="lead">
        Поэт, композитор, певец. Начинал как автор лирических песен, а на рубеже
        1990-х стал одним из самых резких голосов своего времени. Он пел о России,
        о революции и Гражданской войне, о вере и о любви. Погиб в 34 года
        за кулисами концерта в Санкт-Петербурге.
      </p>
      <div class="actions">
        <a class="btn" href="/pesni/">Открыть песни</a>
        <button class="btn btn--ghost" type="button" data-random>Случайная карточка</button>
      </div>
      <p class="credit">
        Фото: Лев Медведев, январь 1991 (снимок обработан){' · '}<a href="https://commons.wikimedia.org/wiki/File:ITalkov.jpg">Wikimedia Commons</a>{', '}<a href="https://creativecommons.org/licenses/by-sa/4.0/deed.ru">CC BY-SA 4.0</a>.
        Автограф: <a href="https://commons.wikimedia.org/wiki/File:Автограф_Игоря_Талькова.jpg">Wikimedia Commons</a>, общественное достояние
      </p>
    </div>
  </section>

  <section class="wrap" aria-labelledby="sides-h">
    <h2 id="sides-h" class="h2">Две стороны</h2>
    <p class="intro">
      В одном человеке уживались нежность и бескомпромиссная правда.
      Поэтому каждая песня в картотеке отнесена к одной из двух линий.
      Переверните медаль.
    </p>
    <Medal lyric={lyric} civic={civic} />
  </section>

  <section class="wrap" aria-labelledby="drawers-h">
    <h2 id="drawers-h" class="h2">Ящики картотеки</h2>
    <div class="drawers">
      {drawers.map((d) => <Drawer {...d} />)}
    </div>
  </section>

  <section class="wrap coda" aria-label="Строки из песни «Я вернусь»" data-reveal>
    <blockquote>
      <p>Я пророчить не берусь,<br /><span>Но точно знаю, что вернусь…</span></p>
    </blockquote>
    <a class="coda__src" href={coda.href}>{coda.code} · «{coda.title}»</a>
  </section>
</Base>

<style>
  .hero {
    display: grid;
    grid-template-columns: 1fr 1fr;
    min-height: min(88vh, 860px);
  }

  .hero__photo {
    position: relative;
    overflow: hidden;
  }

  .hero__photo :global(picture img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 25%;
  }

  /* Фото уходит в чёрный зал справа */
  .hero__photo::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent 55%, var(--bg));
    pointer-events: none;
  }

  /* Луч софита медленно ходит по сцене */
  .hero__photo::before {
    content: '';
    position: absolute;
    z-index: 1;
    top: -10%;
    left: -5%;
    width: 75%;
    height: 80%;
    background: radial-gradient(closest-side, rgb(255 236 214 / 0.13), transparent);
    mix-blend-mode: screen;
    pointer-events: none;
    opacity: 0;
  }

  /* Автограф поверх снимка, белыми чернилами по чёрному пиджаку */
  .hero__photo :global(.hero__sig) {
    position: absolute;
    z-index: 2;
    left: 5%;
    bottom: 5%;
    width: min(38%, 300px);
    height: auto;
    filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.6));
    opacity: 0.92;
  }

  .hero h1 span {
    display: block;
  }

  .hero__text {
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: 56px clamp(16px, 5vw, 72px) 56px clamp(16px, 3vw, 40px);
  }

  .hero h1 {
    font-family: var(--display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(4.5rem, 10vw, 9rem);
    line-height: 0.82;
    letter-spacing: 0.01em;
    margin: 0 0 24px;
  }

  .dates {
    display: flex;
    align-items: center;
    gap: 16px;
    font-family: var(--display);
    font-weight: 600;
    font-size: 2rem;
    margin: 0 0 24px;
  }

  .dates i {
    flex: 0 0 64px;
    height: 3px;
    background: var(--red);
  }

  .lead {
    color: var(--text-soft);
    max-width: 46ch;
    margin: 0 0 28px;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .credit {
    font-size: 0.78rem;
    color: var(--muted);
    margin: 32px 0 0;
  }

  .intro {
    color: var(--text-soft);
    max-width: 56ch;
    margin: -12px 0 36px;
  }

  /* Последняя строка главной: главная начинается датами 1956–1991, а заканчивается обещанием вернуться. */
  .coda {
    padding-top: clamp(72px, 12vw, 150px);
    padding-bottom: clamp(24px, 5vw, 56px);
  }

  .coda blockquote {
    margin: 0 0 20px;
  }

  .coda blockquote::before {
    content: '';
    display: block;
    width: 64px;
    height: 3px;
    margin-bottom: 28px;
    background: var(--red);
  }

  .coda p {
    margin: 0;
    font-family: var(--display);
    font-weight: 800;
    text-transform: uppercase;
    font-size: clamp(2.6rem, 7vw, 5.6rem);
    line-height: 0.9;
    text-wrap: balance;
  }

  .coda p span {
    color: var(--red);
  }

  .coda__src {
    color: var(--muted);
    font-size: 0.85rem;
    text-decoration: none;
  }

  .coda__src:hover {
    color: var(--text);
    text-decoration: underline;
  }

  /* ── Выход на сцену ──
     Загорается софит, выходит имя, прочерчивается линия между датами,
     и в конце сам собой пишется автограф. */
  @property --spot {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 300%;
  }

  @property --ink {
    syntax: '<percentage>';
    inherits: false;
    initial-value: 130%;
  }

  @media (prefers-reduced-motion: no-preference) {
    .hero__photo :global(picture img) {
      mask-image: radial-gradient(ellipse 62% 58% at 50% 32%, #000 calc(var(--spot) - 45%), transparent var(--spot));
      animation: spot-on 2.4s linear 0.1s both;
    }

    .hero__photo::before {
      animation: haze 16s ease-in-out 2s infinite alternate;
    }

    .hero__photo :global(.hero__sig) {
      mask-image: linear-gradient(100deg, #000 calc(var(--ink) - 14%), transparent var(--ink));
      animation: ink 1.9s cubic-bezier(0.5, 0.1, 0.4, 1) 1.9s both;
    }

    .hero h1 span {
      animation: rise 0.9s cubic-bezier(0.2, 0.7, 0.1, 1) 0.35s both;
    }

    .hero h1 span + span {
      animation-delay: 0.5s;
    }

    .dates span {
      animation: fade 0.6s ease 0.85s both;
    }

    .dates i {
      transform-origin: left;
      animation: line 0.7s cubic-bezier(0.6, 0, 0.2, 1) 0.8s both;
    }

    .lead,
    .actions,
    .credit {
      animation: rise 0.8s cubic-bezier(0.2, 0.7, 0.1, 1) 1s both;
    }

    .actions {
      animation-delay: 1.12s;
    }

    .credit {
      animation-name: fade;
      animation-delay: 1.6s;
    }
  }

  /* Сначала луч выхватывает лицо, потом свет заливает всю сцену */
  @keyframes spot-on {
    from {
      --spot: 0%;
      filter: brightness(0.35) contrast(1.2);
      animation-timing-function: cubic-bezier(0.2, 0.6, 0.3, 1);
    }

    40% {
      --spot: 62%;
      filter: brightness(0.75) contrast(1.1);
      animation-timing-function: cubic-bezier(0.5, 0, 0.3, 1);
    }

    to {
      --spot: 300%;
      filter: none;
    }
  }

  @keyframes haze {
    0% {
      opacity: 0;
      translate: 0 0;
    }

    25% {
      opacity: 1;
    }

    100% {
      opacity: 0.7;
      translate: 40% 25%;
    }
  }

  @keyframes ink {
    from {
      --ink: 0%;
    }
  }

  @keyframes rise {
    from {
      opacity: 0;
      translate: 0 0.5em;
    }
  }

  @keyframes fade {
    from {
      opacity: 0;
    }
  }

  @keyframes line {
    from {
      transform: scaleX(0);
    }
  }

  .drawers {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 24px 12px;
  }

  @media (max-width: 900px) {
    .drawers {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  @media (max-width: 820px) {
    .hero {
      grid-template-columns: 1fr;
      min-height: 0;
    }

    .hero__photo {
      aspect-ratio: 4 / 5;
    }

    .hero__photo::after {
      background: linear-gradient(180deg, transparent 60%, var(--bg));
    }

    .hero__photo :global(.hero__sig) {
      bottom: 9%;
      width: 42%;
    }

    .hero__text {
      padding-top: 8px;
    }
  }
</style>
